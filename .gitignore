# FashionMNIST Project - .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Project specific
# *.pt      # MODEL: uncomment to track .pt checkpoints
# *.pth     # MODEL: uncomment to track .pth checkpoints
*.ckpt
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
logs/*.log
results/runs/*
!results/runs/.gitkeep
logs/

# OS
.DS_Store
Thumbs.db

# Project files
*.csv
*.npy
*.npz
